<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="pagina" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="co.edu.upn.arena.CompetenciaController">

    <Label styleClass="titulo" text="Competencias" />

    <HBox alignment="CENTER_LEFT" spacing="8">
        <ComboBox fx:id="cbEquipoA" promptText="Equipo A" />
        <Label text="vs" />
        <ComboBox fx:id="cbEquipoB" promptText="Equipo B" />
        <DatePicker fx:id="dpFecha" promptText="Fecha" />
        <Button onAction="#programar" styleClass="boton-principal" text="Programar" />
    </HBox>

    <TableView fx:id="tabla" prefHeight="199.0" prefWidth="692.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colEquipoA" prefWidth="180" text="Equipo A" />
            <TableColumn fx:id="colEquipoB" prefWidth="180" text="Equipo B" />
            <TableColumn fx:id="colFecha" prefWidth="120" text="Fecha" />
            <TableColumn fx:id="colMarcador" prefWidth="100" text="Marcador" />
            <TableColumn fx:id="colEstado" prefWidth="110" text="Estado" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Resultado de la competencia seleccionada:" />
        <TextField fx:id="txtMarcadorA" prefWidth="60" promptText="A" />
        <Label text="-" />
        <TextField fx:id="txtMarcadorB" prefWidth="60" promptText="B" />
        <Button onAction="#registrarResultado" styleClass="boton-principal" text="Registrar resultado" />
    </HBox>
</VBox>
