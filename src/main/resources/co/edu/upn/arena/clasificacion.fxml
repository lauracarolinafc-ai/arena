<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="pagina" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="co.edu.upn.arena.ClasificacionController">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Clasificación" styleClass="titulo"/>
        <Button text="Actualizar tabla" onAction="#calcular" styleClass="boton-actualizar"/>
    </HBox>


    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPos" prefWidth="45" text="#" />
            <TableColumn fx:id="colEquipo" prefWidth="220" text="Equipo" />
            <TableColumn fx:id="colPJ" prefWidth="55" text="CJ" />
            <TableColumn fx:id="colPG" prefWidth="55" text="CG" />
            <TableColumn fx:id="colPE" prefWidth="55" text="CE" />
            <TableColumn fx:id="colPP" prefWidth="55" text="CP" />
            <TableColumn fx:id="colDif" prefWidth="60" text="Dif" />
            <TableColumn fx:id="colPts" prefWidth="60" text="Pts" />
        </columns>
    </TableView>
</VBox>
