<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com"
      xmlns:fx="http://javafx.com"
      fx:controller="co.edu.upn.arena.JugadorController"
      spacing="12" styleClass="pagina">


    <Label text="Jugadores" styleClass="titulo"/>

    <HBox spacing="8">
        <TextField fx:id="txtNombre" promptText="Nombre del artista" prefWidth="220"/>
        <TextField fx:id="txtAlias" promptText="Nombre artistico" prefWidth="210"/>
        <TextField fx:id="txtCorreo" promptText="Correo" prefWidth="220"/>
    </HBox>

    <HBox spacing="8">
        <Button text="Guardar" onAction="#guardar" styleClass="boton-principal"/>
        <Button text="Actualizar" onAction="#actualizar" styleClass="boton-actualizar"/>
        <Button text="Eliminar" onAction="#eliminar" styleClass="boton-peligro"/>
        <Button text="Limpiar" onAction="#limpiar" styleClass="boton-limpiar"/>
    </HBox>

    <TableView fx:id="tabla" onMouseClicked="#seleccionar" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Artista" prefWidth="240"/>
            <TableColumn fx:id="colAlias" text="Nombre artistico" prefWidth="180"/>
            <TableColumn fx:id="colCorreo" text="Contacto" prefWidth="240"/>
        </columns>
    </TableView>
</VBox>
